<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>xgen</ToolCommandName>
		<PackageId>MCAkbayir.XFramework.Generator.Tool</PackageId>
		<Version>1.0.5</Version>
		<Authors>mertcanakbayir</Authors>
		<Description>XFramework code generator CLI tool for scaffolding entities, repositories, and services.</Description>
		<RepositoryUrl>https://github.com/mertcanakbayir/XFramework</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>xframework;generator;cli;scaffolding;dotnet-tool</PackageTags>
		<PackageOutputPath>../nupkg</PackageOutputPath>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.11" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.11" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
